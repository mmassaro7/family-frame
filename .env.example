# Copy these into Vercel → Project → Settings → Environment Variables (never commit real values)

# Optional but recommended: a secret so strangers can't read your calendar through your URL.
# Then use https://YOUR-APP.vercel.app/?key=THIS_VALUE as the frame's start URL.
FRAME_KEY=

# Your time zone (for events that don't carry one)
TIMEZONE=America/New_York

# JSON list. "person" is an id from js/config.js, or "family" for everyone.
# URL = Google Calendar → Settings → your calendar → "Secret address in iCal format"
CALENDARS=[{"person":"family","url":"https://calendar.google.com/calendar/ical/.../basic.ics"},{"person":"alex","url":"https://calendar.google.com/calendar/ical/.../basic.ics"}]

# Photos from a Google Drive folder shared as "Anyone with the link"
DRIVE_FOLDER_ID=
GOOGLE_API_KEY=

# Shared shopping list: added automatically when you connect Upstash Redis in the Vercel Marketplace
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional key that can ONLY add items to the to-do and shopping lists (use it for Alexa / Siri / automations).
# See docs/ALEXA.md and docs/TODO-VOICE.md
ADD_KEY=

# To Do list: 4-8 digit PIN that phones enter after scanning the QR code on the To Do tab. Needs FRAME_KEY too.
TODO_PIN=
